fn main() -> int {
    // Array support (Sprint 7)
    int arr[5];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    arr[3] = 40;
    arr[4] = 50;
    
    int total = 0;
    // For loop (Sprint 6)
    for (int i = 0; i < 5; i = i + 1) {
        total = total + arr[i];
    }
    
    // External call (Sprint 7)
    printf("Total sum of array: %d\n", total);
    
    return total;
}
