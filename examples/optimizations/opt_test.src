fn main() -> int {
    int a = 2 + 3;      // Будет свернуто в a = 5
    int b = a * 2;      // a заменится на 5, результат b = 10
    int c = b + 0;      // b заменится на 10, +0 удалится
    int d = 100;        // Мертвый код (не используется) — будет удален
    return b;           // Вернет 10
}
