fn main() -> int {
    int arr[10];
    arr[0] = 64;
    arr[1] = 34;
    arr[2] = 25;
    arr[3] = 12;
    arr[4] = 22;
    arr[5] = 11;
    arr[6] = 90;
    arr[7] = 45;
    arr[8] = 7;
    arr[9] = 53;

    printf("Bubble Sort\n");
    printf("Before: ");
    for (int i = 0; i < 10; i = i + 1) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    // Bubble sort: N-1 passes, each pass bubbles the max to the end
    int n = 10;
    for (int pass = 0; pass < n - 1; pass = pass + 1) {
        for (int j = 0; j < n - 1 - pass; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                int tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
        }
    }

    printf("After:  ");
    for (int i = 0; i < 10; i = i + 1) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    printf("Bubble sort complete!\n");

    return 0;
}
