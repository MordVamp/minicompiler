fn main() -> int {
    int n = 300;
    int arr[300];

    // Fill with pseudo-random values: (i*7919 + 997) % 1000 + 1
    for (int i = 0; i < 300; i = i + 1) {
        arr[i] = (i * 7919 + 997) % 1000 + 1;
    }

    printf("Bubble Sort (n=300, heap-allocated)\n");
    printf("Before [0..9]: ");
    for (int i = 0; i < 10; i = i + 1) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    // Bubble sort: O(n^2) with early-exit optimisation
    for (int pass = 0; pass < n - 1; pass = pass + 1) {
        for (int j = 0; j < n - 1 - pass; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                int tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
        }
    }

    printf("After  [0..9]: ");
    for (int i = 0; i < 10; i = i + 1) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    printf("After  [290..299]: ");
    for (int i = 290; i < 300; i = i + 1) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    // Verify sorted
    int ok = 1;
    for (int i = 0; i < 299; i = i + 1) {
        if (arr[i] > arr[i + 1]) {
            ok = 0;
        }
    }
    if (ok == 1) {
        printf("Sorted correctly!\n");
    }

    free(arr);

    return 0;
}
