fn main() -> int {
    int n = 300;
    int arr[300];

    // Fill with pseudo-random values: (i*7919 + 997) % 1000 + 1
    for (int i = 0; i < 300; i = i + 1) {
        arr[i] = (i * 7919 + 997) % 1000 + 1;
    }

    printf("Quick Sort (n=300, heap-allocated)\n");
    printf("Before [0..9]: ");
    for (int i = 0; i < 10; i = i + 1) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    // Iterative quicksort with explicit stack (64-deep, enough for n=300)
    int stack_lo[64];
    int stack_hi[64];
    int top = 0;

    stack_lo[0] = 0;
    stack_hi[0] = n - 1;
    top = 1;

    while (top > 0) {
        top = top - 1;
        int lo = stack_lo[top];
        int hi = stack_hi[top];

        if (lo < hi) {
            int pivot = arr[hi];
            int i = lo - 1;
            int j = lo;

            while (j < hi) {
                if (arr[j] <= pivot) {
                    i = i + 1;
                    int tmp = arr[i];
                    arr[i] = arr[j];
                    arr[j] = tmp;
                }
                j = j + 1;
            }

            int pi = i + 1;
            int tmp2 = arr[pi];
            arr[pi] = arr[hi];
            arr[hi] = tmp2;

            if (lo < pi - 1) {
                stack_lo[top] = lo;
                stack_hi[top] = pi - 1;
                top = top + 1;
            }

            if (pi + 1 < hi) {
                stack_lo[top] = pi + 1;
                stack_hi[top] = hi;
                top = top + 1;
            }
        }
    }

    printf("After  [0..9]: ");
    for (int i = 0; i < 10; i = i + 1) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    printf("After  [290..299]: ");
    for (int i = 290; i < 300; i = i + 1) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    // Verify sorted
    int ok = 1;
    for (int i = 0; i < 299; i = i + 1) {
        if (arr[i] > arr[i + 1]) {
            ok = 0;
        }
    }
    if (ok == 1) {
        printf("Sorted correctly!\n");
    }

    free(arr);
    free(stack_lo);
    free(stack_hi);

    return 0;
}
